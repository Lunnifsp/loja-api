generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String
  produtos Produto[]
}

model Produto {
  id          Int       @id @default(autoincrement())
  nome        String
  descricao   String?
  preco       Float
  estoque     Int?      @default(0)
  criadoEm    DateTime  @default(now())
  categoriaId Int
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
}
